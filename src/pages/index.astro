---
import Layout from "@/layouts/Layout.astro";

import AboutMe from "@/components/AboutMe.astro";
import Briefcase from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Experience from "@/components/Experience.astro";
import FocusAreas from "@/components/FocusAreas.astro";
import MailIcon from "@/components/icons/Mail.astro";
import ProfileCheck from "@/components/icons/ProfileCheck.astro";
import Projects from "@/components/Projects.astro";
import RecruiterCTA from "@/components/RecruiterCTA.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Hero from "@/components/Hero.astro";
import SystemIcon from "@/components/icons/System.astro";
import TitleSection from "@/components/TitleSection.astro";
---

<Layout
  title="Joan Marqueño | Developer · Python, LLMs y Kubernetes"
  description="Developer Python con 3+ años en plataforma IDP enterprise: +30 clientes, +1M docs. Agentes, tool calling, RabbitMQ, KEDA, LangChain, Azure OpenAI y Kubernetes."
  image="/foto.jpeg"
  type="profile"
>
  <main class="px-4">
    <SectionContainer class="pt-24 pb-12 md:pt-28 md:pb-16">
      <Hero />
    </SectionContainer>

    <div class="space-y-16 pb-8 md:space-y-20">
      <SectionContainer id="especialidades">
        <TitleSection>
          <SystemIcon class="size-7" />
          Especialidades
        </TitleSection>
        <FocusAreas />
      </SectionContainer>

      <SectionContainer id="experiencia">
        <TitleSection>
          <Briefcase class="size-8" />
          Experiencia
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7" />
          Proyectos
        </TitleSection>
        <Projects />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <TitleSection>
          <ProfileCheck class="size-8" />
          Sobre mí
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer id="contacto" class="pb-10">
        <TitleSection>
          <MailIcon class="size-7" />
          Contacto
        </TitleSection>
        <RecruiterCTA />
      </SectionContainer>
    </div>
  </main>
</Layout>
