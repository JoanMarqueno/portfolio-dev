---
import "@fontsource-variable/onest";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: string;
}

const {
  description,
  title,
  image = "/foto.jpeg",
  url,
  type = "website",
} = Astro.props;

const siteUrl = new URL(url ?? Astro.site ?? "https://joanmarqueno.vercel.app");
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const absoluteImage = new URL(image, siteUrl).toString();
const currentDate = new Date().toISOString();
const personId = `${siteUrl.toString()}#person`;
const websiteId = `${siteUrl.toString()}#website`;

const personDescription =
  "Desarrollador Full Stack con 3+ años de experiencia construyendo producto con Python, TypeScript e IA aplicada. Experiencia en IDP, LLMs, RAG, APIs, frontend, Azure y arquitectura hexagonal.";

const sameAs = [
  "https://linkedin.com/in/joanmarqueno",
  "https://github.com/JoanMarqueno",
];

const profilePageStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${pageUrl}#profile`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: "es-ES",
  dateModified: currentDate,
  mainEntity: {
    "@id": personId,
  },
};

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personId,
  name: "Joan Marqueño",
  url: siteUrl.toString(),
  image: absoluteImage,
  description: personDescription,
  email: "mailto:joan.marquenyo@gmail.com",
  jobTitle: "Full Stack Developer & AI Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Inetum",
    url: "https://www.inetum.com/",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Tarragona",
    addressRegion: "Catalunya",
    addressCountry: "ES",
  },
  sameAs,
  mainEntityOfPage: pageUrl,
  knowsAbout: [
    "Python",
    "TypeScript",
    "Generative AI",
    "LLMs",
    "RAG",
    "Document AI",
    "Arquitectura hexagonal",
    "Azure",
    "AKS",
    "Next.js",
    "APIs",
  ],
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "certificate",
    name: "Microsoft Certified: Azure AI Engineer Associate",
  },
};

const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  url: siteUrl.toString(),
  name: "Joan Marqueño | Portfolio",
  description,
  inLanguage: "es-ES",
  author: {
    "@id": personId,
  },
};

const mysticMeStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "MysticMe",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "Android",
  description:
    "Aplicación móvil creada por Joan Marqueño y publicada en Google Play.",
  author: {
    "@id": personId,
  },
  url: "https://mysticme.vercel.app/",
  downloadUrl:
    "https://play.google.com/store/apps/details?id=com.joanm.mysticme",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
};

const kadoStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kado Masajes",
  description:
    "Sitio web corporativo diseñado y desarrollado por Joan Marqueño.",
  creator: {
    "@id": personId,
  },
  url: "https://kadomasajes.com",
  inLanguage: "es",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <meta
      name="google-site-verification"
      content="UWMNlvAGa7vSqU0wmq9gqM5yyyMOMQs7TWLkDrN6NdI"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Joan Marqueño" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#0f766e" />
    <meta name="application-name" content="Joan Marqueño Portfolio" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="es-ES" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Joan Marqueño Portfolio" />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:creator" content="@joanmarqueno" />

    <meta name="msapplication-TileColor" content="#0f766e" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(profilePageStructuredData)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personStructuredData)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteStructuredData)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(mysticMeStructuredData)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(kadoStructuredData)}
    />
  </head>

  <body class="relative min-h-screen bg-transparent text-stone-900 antialiased dark:text-stone-100">
    <div
      class="pointer-events-none absolute inset-0 z-[-2] min-h-screen w-full bg-[radial-gradient(circle_at_top_left,rgba(20,184,166,0.15),transparent_28%),radial-gradient(circle_at_top_right,rgba(245,158,11,0.16),transparent_22%),linear-gradient(180deg,rgba(247,244,236,1),rgba(247,244,236,0.98))] dark:bg-[radial-gradient(circle_at_top_left,rgba(45,212,191,0.14),transparent_32%),radial-gradient(circle_at_top_right,rgba(251,191,36,0.12),transparent_24%),linear-gradient(180deg,rgba(2,6,23,1),rgba(15,23,42,0.98))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      :root {
        color-scheme: light dark;
        --page-bg: #f7f4ec;
        --page-text: #1c1917;
        --surface: rgba(255, 255, 255, 0.8);
        --surface-border: rgba(120, 113, 108, 0.22);
        --accent: #0f766e;
        --accent-warm: #b45309;
      }

      html.dark {
        --page-bg: #020617;
        --page-text: #f8fafc;
        --surface: rgba(15, 23, 42, 0.76);
        --surface-border: rgba(71, 85, 105, 0.35);
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
        background: var(--page-bg);
      }

      body {
        color: var(--page-text);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      ::selection {
        background: rgba(15, 118, 110, 0.22);
        color: inherit;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
