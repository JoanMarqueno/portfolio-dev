---
import LinkInline from "./LinkInline.astro";

interface Props {
  title: string;
  company: string;
  description: string | string[];
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
const isArray = Array.isArray(description);
---

<div
  class="relative grid gap-5 pb-10 pl-8 before:absolute before:left-[7px] before:top-3 before:block before:h-full before:border-l before:border-stone-300 before:content-[''] dark:before:border-slate-700 md:grid-cols-[220px_minmax(0,1fr)] md:gap-8 md:pl-0 md:before:left-[214px]"
>
  <span class="absolute left-0 top-2 size-4 rounded-full border-4 border-white bg-teal-600 shadow-sm dark:border-slate-950 dark:bg-teal-300 md:left-[207px]"></span>

  <div class="relative">
    <p class="text-xs font-medium uppercase tracking-[0.24em] text-stone-500 dark:text-slate-400">
      {date}
    </p>
    <h3 class="mt-3 text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
      {title}
    </h3>
    <h4 class="mt-1 text-lg font-medium text-teal-700 dark:text-teal-300">
      {company}
    </h4>
  </div>

  <div class="relative rounded-[1.75rem] border border-stone-200/80 bg-white/75 p-6 text-stone-700 shadow-[0_18px_50px_-32px_rgba(28,25,23,0.35)] backdrop-blur dark:border-slate-800 dark:bg-slate-950/70 dark:text-slate-300">
    {
      isArray ? (
        <ul class="flex flex-col gap-3">
          {description.map((item) => (
            <li class="flex gap-3 text-base leading-7">
              <span class="mt-3 size-2 rounded-full bg-amber-500 dark:bg-amber-300"></span>
              <span class="flex-1">{item}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-base leading-7">{description}</p>
      )
    }
    {
      link && (
        <div class="mt-5">
          <LinkInline href={link}>
            Ver empresa{" "}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 icon icon-tabler icon-tabler-chevron-right"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 6l6 6l-6 6" />
              </>
            </svg>
          </LinkInline>
        </div>
      )
    }
  </div>
</div>
