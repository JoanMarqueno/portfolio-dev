---
const AREAS = [
  {
    title: "Microservicios y orquestación",
    description:
      "+20 servicios Python especializados consumidos vía RabbitMQ: OCR, clasificación, extracción GPT, validación, anonimización, Whisper y flujos configurables.",
    tags: ["Python", "RabbitMQ", "Whisper", "Document AI"],
  },
  {
    title: "Agentes LLM en producción",
    description:
      "Tool calling con LangChain, structured outputs strict mode, esquemas dinámicos por tipo documental y HITL cuando la confianza no alcanza el umbral.",
    tags: ["Tool calling", "HITL", "LangChain", "Azure OpenAI"],
  },
  {
    title: "Escala y fiabilidad",
    description:
      "KEDA, tenant isolation, Redis para distributed locking, observabilidad de costes de tokens y resolución de incidentes reales en producción.",
    tags: ["KEDA", "Redis", "Kubernetes", "On-premise"],
  },
  {
    title: "Plataforma multi-cloud",
    description:
      "Despliegue en Azure, AWS y on-premise con Keycloak y configuración por cliente. +30 clientes activos y +200k documentos/mes.",
    tags: ["Azure", "AWS", "Keycloak", "Hexagonal"],
  },
];
---

<div class="grid gap-4 md:grid-cols-2">
  {
    AREAS.map(({ title, description, tags }) => (
      <article class="rounded-xl border border-stone-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
        <h3 class="text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">
          {title}
        </h3>

        <p class="mt-3 text-base leading-7 text-stone-700 dark:text-slate-300">
          {description}
        </p>

        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-0.5 text-xs text-stone-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
