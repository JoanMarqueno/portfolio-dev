---
const personalImageAlt = "Joan Marqueño";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";
import SocialPill from "@/components/SocialPill.astro";

const SPECIALTIES = [
  "Python",
  "LangChain",
  "Kubernetes",
  "Azure OpenAI",
  "RabbitMQ · KEDA",
  "Structured outputs",
];

const IMPACT_POINTS = [
  "+20 microservicios Python orquestados por RabbitMQ: OCR, clasificación, extracción GPT, validación, Whisper y más.",
  "Agentes con tool calling y structured outputs strict mode; HITL cuando la confianza no alcanza el umbral.",
  "Producción a escala: +30 clientes, +200k docs/mes, KEDA, Redis, observabilidad de costes y fixes reales en Azure OpenAI.",
];

const SNAPSHOT = [
  { label: "Clientes", value: "+30 activos" },
  { label: "Volumen", value: "+200k/mes" },
  { label: "Procesados", value: "+1M docs" },
  { label: "Experiencia", value: "3+ años" },
];
---

<div class="max-w-3xl">
  <div class="mb-5 flex flex-wrap items-center gap-4">
    <img
      class="size-16 rounded-xl border border-stone-200 object-cover dark:border-slate-800"
      src="/foto.jpeg"
      alt={personalImageAlt}
      width="64"
      height="64"
      loading="eager"
      fetchpriority="high"
    />
    <div class="space-y-1.5">
      <Badge>Abierto a nuevas oportunidades</Badge>
      <p class="text-sm text-stone-500 dark:text-slate-400">
        Developer · Python · LLMs · Kubernetes
      </p>
    </div>
  </div>

  <h1
    class="text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl md:text-5xl dark:text-stone-50"
  >
    Python y sistemas LLM en producción
  </h1>

  <p class="mt-5 text-lg leading-8 text-stone-700 dark:text-slate-300">
    <strong class="font-semibold text-stone-900 dark:text-stone-50">
      3+ años en plataforma IDP enterprise: +30 clientes, +1M documentos procesados.
    </strong>
    {" "}Agentes con tool calling, orquestación event-driven, arquitectura hexagonal en
    Kubernetes (Azure, AWS y on-premise) y resolución de problemas reales de producción.
  </p>

  <ul class="mt-6 space-y-2">
    {
      IMPACT_POINTS.map((point) => (
        <li class="flex gap-3 text-base leading-7 text-stone-700 dark:text-slate-300">
          <span
            class="mt-2 size-1.5 shrink-0 rounded-full bg-teal-600 dark:bg-teal-400"
            aria-hidden="true"
          />
          <span>{point}</span>
        </li>
      ))
    }
  </ul>

  <dl
    class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4"
    aria-label="Resumen profesional"
  >
    {
      SNAPSHOT.map(({ label, value }) => (
        <div class="rounded-xl border border-stone-200 bg-white px-3 py-3 dark:border-slate-800 dark:bg-slate-950">
          <dt class="text-xs text-stone-500 dark:text-slate-400">{label}</dt>
          <dd class="mt-1 text-sm font-semibold text-stone-900 dark:text-stone-50">
            {value}
          </dd>
        </div>
      ))
    }
  </dl>

  <p
    class="mt-6 inline-flex rounded-lg border border-amber-200/80 bg-amber-50 px-3 py-2 text-sm text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-100"
  >
    Microsoft Certified: Azure AI Engineer Associate
  </p>

  <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack principal">
    {
      SPECIALTIES.map((specialty) => (
        <li class="rounded-full border border-stone-200 bg-white px-3 py-1 text-sm text-stone-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
          {specialty}
        </li>
      ))
    }
  </ul>

  <nav class="mt-8 flex flex-wrap gap-3" aria-label="Acciones principales">
    <a
      href="/cv-joan-marqueno.pdf"
      download
      class="inline-flex items-center gap-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500"
    >
      Descargar CV
    </a>
    <SocialPill href="mailto:joan.marquenyo@gmail.com">
      <MailIcon class="size-4" />
      Email
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/joanmarqueno">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/JoanMarqueno">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
