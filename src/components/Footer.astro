---
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto mt-12 w-full max-w-5xl px-4 pb-10">
  <div
    class="rounded-xl border border-stone-200 bg-white px-6 py-5 text-sm text-stone-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-400"
  >
    <div
      class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-6"
    >
      <p class="max-w-2xl leading-7">
        © {currentYear}
        <a
          href="https://linkedin.com/in/joanmarqueno"
          class="font-medium text-stone-900 transition hover:text-teal-700 dark:text-stone-50 dark:hover:text-teal-300"
        >
          Joan Marqueño
        </a>. Full Stack · Python · TypeScript · IA aplicada.
      </p>

      <nav class="flex flex-wrap gap-x-5 gap-y-2 lg:justify-end">
        <a
          href="/cv-joan-marqueno.pdf"
          download
          class="transition hover:text-teal-700 dark:hover:text-teal-300"
        >
          CV
        </a>
        <a
          href="/#experiencia"
          class="transition hover:text-teal-700 dark:hover:text-teal-300"
        >
          Experiencia
        </a>
        <a
          href="/#proyectos"
          class="transition hover:text-teal-700 dark:hover:text-teal-300"
        >
          Proyectos
        </a>
        <a
          href="/#contacto"
          class="transition hover:text-teal-700 dark:hover:text-teal-300"
        >
          Contacto
        </a>
      </nav>
    </div>
  </div>
</footer>
