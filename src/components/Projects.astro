---
import GitHub from "./icons/GitHub.astro";
import Flutter from "./icons/Flutter.astro";
import React from "./icons/React.astro";
import Tailwind from "./icons/Tailwind.astro";
import TypeScript from "./icons/TypeScript.astro";
import Supabase from "./icons/Supabase.astro";
import Link from "./icons/Link.astro";
import NextJS from "./icons/NextJS.astro";
import LinkButton from "./LinkButton.astro";

const TAGS = {
  PYTHON: {
    name: "Python",
    class: "bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900",
    icon: null,
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#02569B] text-white",
    icon: Flutter,
  },
  REACT: {
    name: "React",
    class: "bg-[#149ECA] text-white",
    icon: React,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178C6] text-white",
    icon: TypeScript,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#3ECF8E] text-white",
    icon: Supabase,
  },
  NEXT: {
    name: "Next.js",
    class: "bg-stone-950 text-white dark:bg-stone-100 dark:text-stone-950",
    icon: NextJS,
  },
  LLM: {
    name: "LLMs",
    class: "bg-teal-700 text-white dark:bg-teal-300 dark:text-slate-950",
    icon: null,
  },
  RAG: {
    name: "RAG",
    class: "bg-amber-600 text-white dark:bg-amber-300 dark:text-slate-950",
    icon: null,
  },
  AZURE: {
    name: "Azure",
    class: "bg-sky-700 text-white dark:bg-sky-300 dark:text-slate-950",
    icon: null,
  },
  K8S: {
    name: "Kubernetes",
    class: "bg-indigo-700 text-white dark:bg-indigo-300 dark:text-slate-950",
    icon: null,
  },
  AGENTS: {
    name: "Agentes",
    class: "bg-violet-700 text-white dark:bg-violet-300 dark:text-slate-950",
    icon: null,
  },
};

const PROJECTS = [
  {
    eyebrow: "Trabajo actual · 2023 – Actualidad",
    title: "Plataforma IDP · IIM-AI4CS",
    description:
      "Plataforma IDP enterprise en Azure, AWS y on-premise: +30 clientes, +200k documentos/mes y contratos de hasta 2M docs/año. +20 microservicios Python, agentes con tool calling, KEDA, HITL y arquitectura hexagonal.",
    privateProject:
      "Plataforma en producción activa — proyecto enterprise en Inetum (IIM-AI4CS).",
    tags: [
      TAGS.PYTHON,
      TAGS.TYPESCRIPT,
      TAGS.K8S,
      TAGS.AGENTS,
      TAGS.RAG,
      TAGS.NEXT,
    ],
  },
  {
    eyebrow: "Producto propio · 2023 – Actualidad",
    title: "MysticMe - Tu Guía Diaria de Tarot y Horóscopo",
    description:
      "App de tarot y horóscopo end-to-end, publicada en Google Play. Flutter · Supabase · Firebase Crashlytics. Crecimiento con TikTok/CapCut.",
    link: "https://mysticme.vercel.app/",
    github: "",
    googlePlay:
      "https://play.google.com/store/apps/details?id=com.joanm.mysticme",
    image: "/mysticme.webp",
    tags: [TAGS.FLUTTER, TAGS.SUPABASE],
  },
  {
    eyebrow: "Proyecto para cliente · 2024",
    title: "Kado Masajes - Web corporativa",
    description:
      "Sitio web corporativo para un negocio local con foco en claridad, conversión y presencia profesional. Diseñado y desarrollado con React, TypeScript y Tailwind para ofrecer una experiencia limpia y responsive.",
    link: "https://kadomasajes.com",
    image: "/kadomasajes.webp",
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
];
---

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(
      ({
        eyebrow,
        image,
        title,
        description,
        tags,
        link,
        github,
        googlePlay,
        privateProject,
      }) => (
        <article class="group grid gap-6 lg:grid-cols-2 lg:items-stretch">
          <div class="w-full">
            <div class="relative h-full overflow-hidden rounded-xl border border-stone-200 bg-white dark:border-slate-800 dark:bg-slate-950">
              {
                image ? (
                  <img
                    alt={`Captura de pantalla del proyecto ${title}`}
                    class="h-full min-h-56 w-full object-cover object-top"
                    src={image}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="flex h-full min-h-56 flex-col justify-between border-l-4 border-teal-600 bg-stone-50 p-6 dark:border-teal-400 dark:bg-slate-900">
                    <span class="w-fit rounded-full border border-stone-200 bg-white px-3 py-1 text-xs font-medium uppercase tracking-wide text-stone-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-400">
                      Trabajo en Inetum
                    </span>
                    <div>
                      <p class="text-sm uppercase tracking-wide text-teal-700 dark:text-teal-300">
                        IA documental
                      </p>
                      <h3 class="mt-2 text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
                        +30 clientes · +200k docs/mes
                      </h3>
                      <p class="mt-2 max-w-md text-sm leading-7 text-stone-700 dark:text-slate-300">
                        Python · RabbitMQ · KEDA · LangChain · HITL
                      </p>
                    </div>
                  </div>
                )
              }
            </div>
          </div>

          <div class="w-full lg:max-w-xl">
            <p class="text-sm font-medium text-stone-500 dark:text-slate-400">
              {eyebrow}
            </p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
              {title}
            </h3>

            <div class="mt-5 flex flex-wrap gap-2">
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li>
                    <span
                      class={`inline-flex items-center gap-x-2 rounded-full px-3 py-1 text-xs font-medium ${tag.class}`}
                    >
                      {tag.icon && <tag.icon class="size-4" />}
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-4 text-base leading-7 text-stone-700 dark:text-slate-300">
              {description}
            </div>

            {
              privateProject && (
                <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-100">
                  {privateProject}
                </p>
              )
            }

            <footer class="mt-6 flex flex-wrap items-end justify-start gap-3">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-5" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
              {googlePlay && (
                <LinkButton href={googlePlay}>
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z" />
                  </svg>
                  Google Play
                </LinkButton>
              )}
            </footer>
          </div>
        </article>
      )
    )
  }
</div>
