---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Especialidades",
    label: "especialidades",
    url: "/#especialidades",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/#contacto",
  },
];
---

<header class="fixed inset-x-0 top-4 z-30 px-4">
  <nav
    id="header-nav"
    class="mx-auto flex w-full max-w-fit items-center gap-1 rounded-full border border-stone-200/80 bg-white/80 px-2 py-2 text-sm font-medium text-stone-600 shadow-[0_20px_45px_-30px_rgba(28,25,23,0.35)] backdrop-blur dark:border-slate-800 dark:bg-slate-950/75 dark:text-slate-200"
  >
    {
      navItems.map((link) => (
        <a
          data-nav-link
          class="rounded-full px-3 py-2 transition hover:bg-stone-100 hover:text-teal-700 dark:hover:bg-slate-900 dark:hover:text-teal-300"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = Array.from(document.querySelectorAll("[data-section]"));
    const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));

    if (!sections.length || !navLinks.length) {
      return;
    }

    const setActive = (id: string) => {
      navLinks.forEach((item) => {
        const isActive = item.getAttribute("aria-label") === id;
        item.classList.toggle("text-teal-700", isActive);
        item.classList.toggle("dark:text-teal-300", isActive);
        item.classList.toggle("bg-stone-100", isActive);
        item.classList.toggle("dark:bg-slate-900", isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      {
        root: null,
        rootMargin: "-30% 0px -45% 0px",
        threshold: 0.1,
      }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
