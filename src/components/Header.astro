---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Especialidades",
    label: "especialidades",
    url: "/#especialidades",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/#contacto",
  },
];
---

<header
  class="fixed inset-x-0 top-0 z-30 border-b border-stone-200/80 bg-white/90 backdrop-blur-sm dark:border-slate-800 dark:bg-slate-950/90"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a
      href="/"
      class="shrink-0 text-sm font-semibold tracking-tight text-stone-900 dark:text-stone-50"
    >
      Joan Marqueño
    </a>

    <nav
      id="header-nav"
      class="hidden items-center gap-1 md:flex"
      aria-label="Navegación principal"
    >
      {
        navItems.map((link) => (
          <a
            data-nav-link
            class="rounded-lg px-3 py-2 text-sm font-medium text-stone-600 transition hover:bg-stone-100 hover:text-teal-700 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-teal-300"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href="/#contacto"
        class="rounded-lg bg-teal-700 px-3 py-2 text-sm font-medium text-white transition hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500"
      >
        Contacto
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-lg border border-stone-200 p-2 text-stone-700 transition hover:bg-stone-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="menu-icon-open"
          class="size-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden size-5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-stone-200/80 bg-white dark:border-slate-800 dark:bg-slate-950 md:hidden"
    aria-label="Menú móvil"
  >
    <nav class="mx-auto flex max-w-5xl flex-col px-4 py-3">
      {
        navItems.map((link) => (
          <a
            data-nav-link
            data-mobile-nav-link
            class="rounded-lg px-3 py-3 text-base font-medium text-stone-700 transition hover:bg-stone-100 hover:text-teal-700 dark:text-slate-200 dark:hover:bg-slate-900 dark:hover:text-teal-300"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
      <div class="mt-2 border-t border-stone-200/80 pt-3 dark:border-slate-800">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = Array.from(document.querySelectorAll("[data-section]"));
    const navLinks = Array.from(document.querySelectorAll("[data-nav-link]"));
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIconOpen = document.getElementById("menu-icon-open");
    const menuIconClose = document.getElementById("menu-icon-close");
    const mobileNavLinks = Array.from(
      document.querySelectorAll("[data-mobile-nav-link]")
    );

    const setMenuOpen = (open: boolean) => {
      if (!menuToggle || !mobileMenu || !menuIconOpen || !menuIconClose) {
        return;
      }

      menuToggle.setAttribute("aria-expanded", String(open));
      menuToggle.setAttribute(
        "aria-label",
        open ? "Cerrar menú de navegación" : "Abrir menú de navegación"
      );
      mobileMenu.classList.toggle("hidden", !open);
      menuIconOpen.classList.toggle("hidden", open);
      menuIconClose.classList.toggle("hidden", !open);
    };

    menuToggle?.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
    });

    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    if (!sections.length || !navLinks.length) {
      return;
    }

    const setActive = (id: string) => {
      navLinks.forEach((item) => {
        const isActive = item.getAttribute("aria-label") === id;
        item.classList.toggle("text-teal-700", isActive);
        item.classList.toggle("dark:text-teal-300", isActive);
        item.classList.toggle("bg-stone-100", isActive);
        item.classList.toggle("dark:bg-slate-900", isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      {
        root: null,
        rootMargin: "-20% 0px -55% 0px",
        threshold: 0.1,
      }
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
