---
import SocialPill from "@/components/SocialPill.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import GitHubIcon from "@/components/icons/GitHub.astro";

const FIT_POINTS = [
  "Plataformas IDP/LLM en producción con Python, Kubernetes y escala real (+clientes, +volumen).",
  "Perfiles backend/IA con experiencia resolviendo incidentes, costes y fiabilidad.",
  "Equipos que valoren arquitectura hexagonal, event-driven y entrega multi-cloud.",
];
---

<div
  class="max-w-3xl rounded-xl border border-stone-200 bg-white p-6 md:p-8 dark:border-slate-800 dark:bg-slate-950"
>
  <h3 class="text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
    Busco retos donde la IA se convierta en producto utilizable
  </h3>
  <p class="mt-3 text-base leading-7 text-stone-700 dark:text-slate-300">
    Me interesan roles de full stack, backend Python o AI engineering con
    arquitectura, integración de modelos y entrega end-to-end.
  </p>

  <ul class="mt-6 space-y-2">
    {
      FIT_POINTS.map((point) => (
        <li class="flex gap-3 text-sm leading-6 text-stone-700 dark:text-slate-300">
          <span
            class="mt-2 size-1.5 shrink-0 rounded-full bg-teal-600 dark:bg-teal-400"
            aria-hidden="true"
          />
          <span>{point}</span>
        </li>
      ))
    }
  </ul>

  <nav class="mt-6 flex flex-wrap gap-3">
    <a
      href="/cv-joan-marqueno.pdf"
      download
      class="inline-flex items-center gap-2 rounded-xl bg-teal-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-teal-800 dark:bg-teal-600 dark:hover:bg-teal-500"
    >
      Descargar CV
    </a>
    <SocialPill href="mailto:joan.marquenyo@gmail.com">
      <MailIcon class="size-4" />
      joan.marquenyo@gmail.com
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/joanmarqueno">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/JoanMarqueno">
      <GitHubIcon class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>
